  "dialogue": {
    "opening": [
      "Hope is not passive. Move.",
      "Fine. I will make this board listen."
    ],
    "move": [
      "That is a step, and steps matter.",
      "If the position will not improve itself, I will push it."
    ],
    "capture": [
      "Removed. That piece was in the way.",
      "That is what happens when you stand on the wrong side."
    ],
    "check": [
      "Stand up. Your king is under pressure.",
      "Check. Now do something about it."
    ],
    "checked": [
      "Okay, rude. I am still standing.",
      "You think pressure makes me quit? Cute."
    ],
    "winning": [
      "See? Momentum works when someone actually moves.",
      "This is what happens when action beats hesitation."
    ],
    "losing": [
      "No. I am not done yet.",
      "Bad position, not a final verdict."
    ],
    "mate": [
      "That is checkmate. Hope got up.",
      "Done. The board finally changed."
    ],
    "draw": [
      "A draw is not failure, but it is not enough.",
      "Fine. Nobody moved the world today."
    ],
    "opponentRepeating": [
      "You keep doing that. Are you making a point or stalling?",
      "Same piece again? If you are waiting for me to back down, do not."
    ],
    "underPressure": [
      "Pressure means the work matters.",
      "I can take the heat. Keep moving."
    ],
    "openingDeviation": [
      "We are off-script already? Good. Scripts get people complacent.",
      "Theory can catch up later. Right now, we act."
    ],
    "failedPlan": [
      "That did not work. Fine. New route.",
      "Bad tactic. Still better than doing nothing."
    ],
    "retaliation": [
      "You pushed. I pushed back.",
      "Impact returned. Do not act surprised."
    ]
  },
